# Copy this file to `.env` in the repo root and fill in your real values.
# `.env` is git-ignored — config/settings.py loads it automatically on any local run
# (including `python run.py --setup`). Never commit `.env` itself.
#
# In GitHub Actions, these are supplied as repo secrets instead (see
# .github/workflows/nightly-pipeline.yml) — this file has no effect in CI.

NOTION_API_KEY=
APIFY_API_TOKEN=
ANTHROPIC_API_KEY=

# Your Jobs Tracker database id. Set automatically by `python run.py --init` (which provisions
# a fresh Notion page + databases via scripts/provision_notion.py), or paste your own here.
# Required -- there is no baked-in default; `python run.py --setup` flags it if unset.
NOTION_DB_ID=

# Database id of the scratch-note database for fast mobile job-link intake (one row per URL;
# see CLAUDE.md "Scratch-note job intake"). Also set by `python run.py --init`. Optional --
# leave blank to disable scratch-note ingest.
NOTION_SCRATCH_PAGE_ID=

# Database id of the restricted-sponsorship-companies database (one company name per row; see
# CLAUDE.md "Restricted-sponsorship company list"). Also set by `python run.py --init`.
# Optional -- leave blank to rely only on the hardcoded RESTRICTED_SPONSORSHIP_COMPANIES
# fallback in config/settings.py.
NOTION_RESTRICTED_COMPANIES_PAGE_ID=

# Database id of the curated target-companies database (one company name per row, plus
# Greenhouse/Lever/Ashby/Last Checked columns; see CLAUDE.md "Target companies list"). Also set
# by `python run.py --init`. Optional -- leave blank to rely only on config/profile.json's
# target_companies and the local config/ats_tokens.json cache, as before this feature existed.
NOTION_TARGET_COMPANIES_PAGE_ID=

# Only needed if you switch AI_PROVIDER / FAST_PROVIDER / QUALITY_PROVIDER
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Only needed for scripts/spike_phase0_leads.py (Step 7 Phase 0 spike)
HUNTER_API_KEY=

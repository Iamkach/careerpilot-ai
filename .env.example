# Copy this file to `.env` in the repo root and fill in your real values.
# `.env` is git-ignored — config/settings.py loads it automatically on any local run
# (including `python run.py --setup`). Never commit `.env` itself.
#
# In GitHub Actions, these are supplied as repo secrets instead (see
# .github/workflows/nightly-pipeline.yml) — this file has no effect in CI.

NOTION_API_KEY=
APIFY_API_TOKEN=
ANTHROPIC_API_KEY=

# Optional -- database id of a scratch-note database for fast mobile job-link intake
# (one row per URL; see CLAUDE.md "Scratch-note job intake"). Leave blank to disable.
NOTION_SCRATCH_PAGE_ID=

# Only needed if you switch AI_PROVIDER / FAST_PROVIDER / QUALITY_PROVIDER
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=

# Only needed for scripts/spike_phase0_leads.py (Step 7 Phase 0 spike)
HUNTER_API_KEY=
